{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "life",
  "version": "0.1.0",
  "identifier": "com.zerdazi.life.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "life",
        "url": "desktop.html",
        "width": 560,
        "height": 760,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../../android/app/src/main/assets/lists/": "lists/" }
  }
}
