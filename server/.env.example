# Copy this file to .env and adjust as needed.

# Port the API + (in production) the built web app are served on.
PORT=3001

# Secret key required for all write/report requests.
# Send it as the "x-api-key" header (or "Authorization: Bearer <key>").
# Change this to something private before exposing the server anywhere.
API_KEY=dev-secret-change-me

# Default poll cadence (minutes) for all integrations; each can override below.
POLL_MINUTES=30

# --- Waking Up integration (meditation) ---
# Polls Waking Up and marks the meditation goal done when mindful_days increases.
# Token = the "authorization" header value from an app.wakingup.com request.
WAKINGUP_TOKEN=
# WAKINGUP_POLL_MINUTES=30
# WAKINGUP_GOAL=Meditation

# --- Google Health integration (exercise / sleep / yoga) ---
# No secrets here: drop the OAuth client JSON in ../auth/ and connect from the UI.
# Optional overrides:
# GOOGLE_POLL_MINUTES=30
# GOOGLE_EXERCISE_GOAL=Exercise
# GOOGLE_SLEEP_GOAL=Sleep
# GOOGLE_YOGA_GOAL=Yoga
