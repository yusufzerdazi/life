<?xml version="1.0" encoding="utf-8"?>
<!-- The logo fills slightly more than the 72dp the launcher mask shows, so the
     mask's circle is the edge. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/bg" />
    <foreground>
        <inset android:drawable="@drawable/logo" android:inset="15%" />
    </foreground>
    <monochrome>
        <inset android:drawable="@drawable/logo_mono" android:inset="15%" />
    </monochrome>
</adaptive-icon>
