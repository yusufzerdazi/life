<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- To read app names for the "blocked" screen. Personal sideload only. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Grayscale evenings. Not grantable in the UI:
         adb shell pm grant com.zerdazi.life android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Meditation: Waking Up's sessions, read from Health Connect. -->
    <!-- Bedtime lights: the Govee strip over Bluetooth LE. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.health.READ_MINDFULNESS" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <application
        android:name=".LifeApp"
        android:label="life"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Life"
        android:allowBackup="true"
        android:usesCleartextTraffic="true">
        <!-- Cleartext: the Hue bridge's local API is plain HTTP on the home network. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect's "why does this app want access" link (Android 13 and below). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- The same link on Android 14+. Health Connect won't grant without it. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Sleep mode: /bed prompt → /dashboard, over the lock screen, while charging. -->
        <activity
            android:name=".SleepActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=".sleep"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />

        <activity
            android:name=".BlockedActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=".blocked"
            android:excludeFromRecents="true" />

        <activity
            android:name=".BreakActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=".break"
            android:excludeFromRecents="true" />

        <!-- Uninstall protection: an active device admin can't be uninstalled. -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:label="life"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".LifeService"
            android:exported="false"
            android:label="life — blocking &amp; sleep mode"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/life_service" />
        </service>
    </application>
</manifest>
