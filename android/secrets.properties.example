# Copy to secrets.properties (gitignored). Compiled into the APK.
# Google Health API — OAuth client from auth/*.json + a refresh token
# (the server stores it in the meta table as google_refresh_token).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Comma-separated dataSource packageNames to accept; empty = all.
GOOGLE_DATA_SOURCES=com.garmin.android.apps.connectmobile
